# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=siga_unmsm
MYSQL_USER=siga_app
MYSQL_PASSWORD=siga_app_pass

# ---- FastAPI ----
# Generar uno real con: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS: orígenes permitidos (separados por coma). Agregar la URL de Next.js
# (con dominio real: https://tu-dominio.pe, no localhost)
BACKEND_CORS_ORIGINS=http://localhost:3000

ENVIRONMENT=development

# ---- Proxy inverso con TLS (solo si vas a usar --profile proxy, ver README) ----
# Dominio real que ya apunta (registro DNS tipo A) a la IP pública de este
# servidor. Sin esto, Caddy no puede pedir el certificado de Let's Encrypt.
DOMAIN=
